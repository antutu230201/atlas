# ============================================================
# Atlas 环境变量样例。复制后再用：
#   cp .env.example apps/api/.env
#   cp .env.example apps/web/.env.local   （只保留 NEXT_PUBLIC_* 段）
# 本地开发所有变量都有安全默认值，.env 文件是可选的。
# 密钥只放环境变量，仓库里只提交本文件（AGENTS.md 禁止事项）。
# ============================================================

# ---------- apps/api ----------
NODE_ENV=development
PORT=3001

# 免 Docker 本地栈（ADR-0002）：EMBEDDED_PG=true 时保持默认 DATABASE_URL 即可，
# API 会用 embedded-postgres 自动拉起本地 PostgreSQL（数据在 apps/api/.local/pgdata）
EMBEDDED_PG=true
# 应用运行时连接（atlas_app，受 RLS 约束，由迁移自动创建）
DATABASE_URL=postgres://atlas_app:atlas_app@localhost:5432/atlas
# 迁移与管理连接（embedded-postgres 初始化的属主角色）
DATABASE_URL_ADMIN=postgres://atlas:atlas@localhost:5432/atlas
PG_DATA_DIR=.local/pgdata

# 使用 docker-compose 时的切换方式：
# EMBEDDED_PG=false

# 本地磁盘存储根目录（相对 apps/api）
STORAGE_DIR=.local/storage

# 允许的前端来源（逗号分隔）
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- docker-compose（可选，见 docker-compose.yml） ----------
# POSTGRES_USER=atlas
# POSTGRES_PASSWORD=atlas
# POSTGRES_DB=atlas
# MINIO_ROOT_USER=atlas
# MINIO_ROOT_PASSWORD=atlas-minio
