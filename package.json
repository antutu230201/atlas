{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas —— 平台内核 + 可插拔模块的个人长期成长型系统",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @atlas/web e2e",
    "prepare": "husky",
    "a11y": "pnpm --filter @atlas/ui a11y",
    "visual": "pnpm --filter @atlas/ui visual"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.35.0"
  }
}
